# ==========================================================
# CONFIGURAÇÕES DO PROXY SOCKS5
# ==========================================================
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
# Deixe em branco se o seu proxy não exigir usuário e senha
PROXY_USERNAME=
PROXY_PASSWORD=
# Tempo limite em milissegundos para negociar a conexão SOCKS5
PROXY_TIMEOUT_MS=15000

# ==========================================================
# CONFIGURAÇÕES DO SERVIDOR DE MINECRAFT
# ==========================================================
# Host do servidor (IP ou domínio, ex: localhost, mc.exemplo.com)
MC_HOST=localhost
MC_PORT=25565

# Versão do Minecraft (ex: 1.20.4, 1.20.1, 1.19.4, 1.16.5, 1.12.2, 1.8.9)
# Deixe vazio para detecção automática baseada no ping do servidor
MC_VERSION=

# Nome do jogador (Bot)
MC_USERNAME=MinerBot

# Modo de autenticação:
# - offline: modo pirata / servidores com online-mode=false
# - microsoft: conta oficial da Mojang/Microsoft
MC_AUTH=offline

# Se true, resolve registros SRV (_minecraft._tcp.host) localmente antes de enviar à proxy.
# Se false (recomendado), passa o domínio direto para o proxy SOCKS5, evitando vazamento de DNS local.
RESOLVE_SRV_LOCALLY=false

# Se true, roteia requisições HTTP de autenticação da Microsoft pelo SOCKS5 também
ROUTE_AUTH_THROUGH_PROXY=true
